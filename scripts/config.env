# Shared configuration for all minecraft-server scripts
# Sourced by: 01-system-setup.sh, 02-deploy.sh, 03-apply-configs.sh,
#             04-pregen.sh, backup.sh
# Adjust these paths if you mount the SSD differently.

DATA_DIR=/srv/minecraft/data
BACKUP_DIR=/srv/backups/minecraft
QUADLET_DIR=/etc/containers/systemd
CONTAINER_NAME=minecraft
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPTS_DIR")"
